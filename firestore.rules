rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict Admin check: authenticated, email matches, and email verified or custom claims
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              (request.auth.token.email in ['omaomar4111@gmail.com'] && 
               request.auth.token.email_verified == true));
    }

    // Public videos collections: Read is public, write is strictly admin
    match /shortVideos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /longVideos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public settings document (main profile info)
    match /settings/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal sensitive settings: Strictly admin read & write
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Explicit default deny for any other document or collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
