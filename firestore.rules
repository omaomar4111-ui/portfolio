rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shortVideos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /longVideos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
